# ----------------------------------------
# App
# ----------------------------------------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ----------------------------------------
# PostgreSQL Configuration
# ----------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flyingclass_db
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/flyingclass_db

# ----------------------------------------
# Redis Configuration
# ----------------------------------------
REDIS_PASSWORD=redis
REDIS_URL=redis://:redis@redis:6379

# ----------------------------------------
# S3 / MinIO Configuration
# ----------------------------------------
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=flyingclass-local-bucket
S3_ENDPOINT=http://minio:9000
# Public endpoint for browser/client access (presigned URL + returned file links)
# In local machine setup this is usually localhost, not docker service name.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1

# MinIO bootstrap (used by docker compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ----------------------------------------
# Mail Configuration
# ----------------------------------------
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_SECURE=false
MAIL_USER=your-mail-user
MAIL_PASS=your-mail-pass
MAIL_FROM=no-reply@flyingclass.local

# ----------------------------------------
# Auth
# ----------------------------------------
JWT_SECRET=replace-with-jwt-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-jwt-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ----------------------------------------
# AI Assistant
# ----------------------------------------
GEMINI_API_KEY=replace-with-gemini-api-key
