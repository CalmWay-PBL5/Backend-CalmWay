{
  "scripts": {
    "build": "nest build -b swc --type-check",
    "postbuild": "node scripts/copy-mail-templates.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "test:api:smoke": "node scripts/api-smoke.mjs",
    "start": "nest start -b swc --type-check",
    "start:dev": "cross-env NODE_OPTIONS='--no-warnings' nest start --watch -b swc --type-check",
    "start:debug": "nest start --watch --debug",
    "start:prod": "node dist/src/main.js",
    "env:sync": "node scripts/sync-env.mjs",
    "prepare": "husky install"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/s3-request-presigner": "^3.1032.0",
    "@fastify/multipart": "^10.0.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/platform-fastify": "^11.1.19",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.73.5",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "handlebars": "^4.7.9",
    "ioredis": "^5.10.1",
    "minio": "^8.0.7",
    "nodemailer": "^8.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@nestjs/cli": "^11.0.19",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.24",
    "@types/bcrypt": "^6.0.0",
    "@types/handlebars": "^4.0.40",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "cross-env": "^10.1.0",
    "husky": "^8.0.0",
    "prisma": "^7.7.0",
    "sync-dotenv": "^2.7.0",
    "ts-node": "^10.9.2"
  },
  "prisma": {
    "seed": "ts-node prisma/seed/main.ts"
  }
}
