    @Query("start") start?: string,
    @Query("end") end?: string,
  ) {
    return await this.queryBus.execute(
      new GetKycStatsQuery(
        start ? this.parseDateOrThrow(start, "start") : undefined,
        end ? this.parseDateOrThrow(end, "end") : undefined,
      ),
    );
