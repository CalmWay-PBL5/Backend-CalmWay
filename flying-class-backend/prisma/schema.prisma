generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "course", "lesson", "payment", "system"]
}

// Vai trò tài khoản trong hệ thống.
enum UserRole {
  // Quản trị viên hệ thống.
  ADMIN
  // Giáo viên tạo/lên lớp học và chấm bài.
  TEACHER
  // Học sinh tham gia lớp, làm bài và theo dõi tiến độ.
  STUDENT

  @@schema("auth")
}

// Trạng thái hoạt động của tài khoản.
enum UserStatus {
  // Tài khoản đang hoạt động bình thường.
  ACTIVE
  // Tài khoản bị khóa/chặn truy cập.
  BANNED

  @@schema("auth")
}

// Bảng người dùng gốc cho toàn hệ thống (đăng nhập, phân quyền, liên kết dữ liệu học tập).
model User {
  // Khóa chính định danh người dùng.
  id           String     @id @default(uuid())
  // Email đăng nhập, duy nhất toàn hệ thống.
  email        String     @unique
  // Mật khẩu đã băm (null nếu đăng nhập social-only).
  passwordHash String?
  // ID người dùng từ Google OAuth, duy nhất nếu có.
  googleId     String?    @unique
  // Vai trò tài khoản: ADMIN / TEACHER / STUDENT.
  role         UserRole   @default(STUDENT)
  // Trạng thái xác minh email/tài khoản.
  isVerified   Boolean    @default(false)
  // Trạng thái tài khoản: ACTIVE hoặc BANNED.
  status       UserStatus @default(ACTIVE)
  // Thời điểm tạo bản ghi.
  createdAt    DateTime   @default(now())
  // Thời điểm cập nhật gần nhất.
  updatedAt    DateTime   @updatedAt

  // Quan hệ 1-1 với hồ sơ cá nhân mở rộng.
  profile      Profile?
  // Danh sách lớp do giáo viên này tạo/quản lý.
  classes      Class[]
  // Danh sách ghi danh lớp của học sinh.
  enrollments  Enrollment[]
  // Danh sách bài nộp thi của học sinh.
  submissions  Submission[]
  // Nhật ký sử dụng tính năng AI của người dùng.
  aiLogs       AiUsageLog[]
  // Danh sách nội dung bị gắn cờ của người dùng.
  flagged      FlaggedContent[]
  // Tiến độ học theo từng bài học.
  progresses   LessonProgress[]
  // Lịch sử giao dịch thanh toán lớp học.
  transactions Transaction[]

  @@schema("auth")
  @@map("users")
}

// Hồ sơ người dùng mở rộng (thông tin cá nhân, liên hệ, giấy tờ).
model Profile {
  // Khóa chính hồ sơ.
  id              String   @id @default(uuid())
  // Khóa ngoại tới users.id, duy nhất để đảm bảo 1 user chỉ có 1 profile.
  userId          String   @unique
  // Họ và tên hiển thị.
  fullName        String?
  // Số điện thoại liên hệ.
  phone           String?
  // URL ảnh đại diện.
  avatar          String?
  // Mô tả ngắn về người dùng.
  bio             String?
  // Email phụ huynh (dành cho học sinh).
  parentEmail     String?
  // URL ảnh CCCD/CMND hoặc giấy tờ định danh.
  identifyCardUrl String?
  // Thời điểm cập nhật hồ sơ gần nhất.
  updatedAt       DateTime @updatedAt

  // Quan hệ ngược về user; xóa user sẽ xóa profile.
  user User @relation(fields: [userId], references:[id], onDelete: Cascade)

  @@schema("auth")
  @@map("profiles")
}

// Danh mục môn học (Toán, Lý, Anh...) để gắn cho lớp học.
model Subject {
  // Khóa chính môn học.
  id          String  @id @default(uuid())
  // Tên môn học duy nhất.
  name        String  @unique
  // Mô tả môn học.
  description String?
  // Danh sách lớp thuộc môn này.
  classes     Class[]

  @@schema("course")
  @@map("subjects")
}

// Bảng lớp học do giáo viên tạo để quản lý nội dung, học sinh, kiểm tra.
model Class {
  // Khóa chính lớp học.
  id          String   @id @default(uuid())
  // ID giáo viên phụ trách lớp.
  teacherId   String
  // ID môn học (có thể null nếu lớp tự do/chưa gắn môn).
  subjectId   String?
  // Tiêu đề lớp học.
  title       String
  // Mô tả ngắn lớp học.
  description String?
  // Học phí lớp học.
  price       Decimal  @default(0) @db.Decimal(12, 2)
  // Mã lớp duy nhất để chia sẻ/tham gia.
  classCode   String   @unique
  // Loại lớp (online/offline/hybrid... tùy quy ước hệ thống).
  type        String
  // Trạng thái lớp (ví dụ: active, archived...).
  status      String   @default("active")
  // Thời điểm tạo lớp.
  createdAt   DateTime @default(now())
  // Thời điểm cập nhật lớp gần nhất.
  updatedAt   DateTime @updatedAt

  // Giáo viên phụ trách lớp.
  teacher User     @relation(fields:[teacherId], references: [id])
  // Môn học của lớp (nếu có).
  subject Subject? @relation(fields: [subjectId], references:[id])
  // Danh sách học sinh ghi danh.
  enrollments Enrollment[]
  // Danh sách đề thi thuộc lớp.
  exams       Exam[]
  // Danh sách lời mời tham gia lớp.
  invitations ClassInvitation[]
  // Danh sách bài học của lớp.
  lessons     Lesson[]
  // Danh sách giao dịch thanh toán liên quan lớp.
  transactions Transaction[]

  @@schema("course")
  @@map("classes")
}

// Bảng ghi danh: liên kết học sinh với lớp học và tiến độ tổng quan.
model Enrollment {
  // Khóa chính bản ghi ghi danh.
  id        String   @id @default(uuid())
  // ID học sinh ghi danh.
  studentId String
  // ID lớp học được ghi danh.
  classId   String
  // Trạng thái ghi danh: active, completed...
  status    String   @default("active")
  // Tiến độ hoàn thành lớp (%).
  progress  Float    @default(0)
  // Thời điểm tham gia lớp.
  joinedAt  DateTime @default(now())

  // Quan hệ tới user (vai trò học sinh).
  student User  @relation(fields: [studentId], references: [id])
  // Quan hệ tới lớp học.
  class   Class @relation(fields: [classId], references: [id])

  // Mỗi học sinh chỉ được ghi danh 1 lần cho mỗi lớp.
  @@unique([studentId, classId])
  @@schema("course")
  @@map("enrollments")
}

// Bảng đề thi của lớp (quiz/test/kiểm tra định kỳ).
model Exam {
  // Khóa chính đề thi.
  id              String   @id @default(uuid())
  // ID lớp học sở hữu đề thi.
  classId         String
  // Tiêu đề đề thi.
  title           String
  // Thời lượng làm bài (phút).
  durationMinutes Int      @default(60)
  // Số lần làm tối đa cho mỗi học sinh.
  maxAttempts     Int      @default(1)
  // Trạng thái đề thi: draft, published...
  status          String   @default("published")
  // Thời điểm tạo đề.
  createdAt       DateTime @default(now())

  // Lớp học chứa đề thi.
  class       Class        @relation(fields: [classId], references: [id])
  // Danh sách câu hỏi trong đề.
  questions   Question[]
  // Danh sách bài nộp của học sinh.
  submissions Submission[]

  @@schema("course")
  @@map("exams")
}

// Bảng câu hỏi thuộc đề thi.
model Question {
  // Khóa chính câu hỏi.
  id            String  @id @default(uuid())
  // ID đề thi chứa câu hỏi.
  examId        String
  // Nội dung câu hỏi.
  content       String  @db.Text
  // Loại câu hỏi: multiple_choice, essay...
  type          String  @default("multiple_choice")
  // Danh sách lựa chọn (JSON array), thường dùng cho trắc nghiệm.
  options       Json?
  // Đáp án đúng (nếu có thể xác định tự động).
  correctAnswer String?
  // Độ khó câu hỏi: easy, medium, hard.
  difficulty    String  @default("medium")
  // Thứ tự hiển thị câu hỏi trong đề.
  orderIndex    Int     @default(0)

  // Xóa đề thi sẽ xóa toàn bộ câu hỏi của đề.
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@schema("course")
  @@map("questions")
}

// Bảng bài nộp của học sinh cho một đề thi.
model Submission {
  // Khóa chính bài nộp.
  id             String   @id @default(uuid())
  // ID đề thi được nộp.
  examId         String
  // ID học sinh nộp bài.
  studentId      String
  // Nội dung câu trả lời (JSON).
  answers        Json
  // Điểm số sau khi chấm (có thể null nếu chưa chấm).
  score          Float?
  // Nhận xét của giáo viên.
  teacherComment String?  @db.Text
  // Thời điểm nộp bài.
  submittedAt    DateTime @default(now())

  // Quan hệ tới đề thi.
  exam    Exam @relation(fields: [examId], references: [id])
  // Quan hệ tới học sinh.
  student User @relation(fields: [studentId], references: [id])

  @@schema("course")
  @@map("submissions")
}

// Bảng lời mời vào lớp (qua token/email).
model ClassInvitation {
  // Khóa chính lời mời.
  id        String   @id @default(uuid())
  // ID lớp học được mời tham gia.
  classId   String
  // Token duy nhất để xác thực lời mời.
  token     String   @unique
  // Email được mời đích danh (null nếu mời công khai bằng link).
  email     String?
  // Cờ đã sử dụng hay chưa.
  isUsed    Boolean  @default(false)
  // Hạn dùng của lời mời.
  expiresAt DateTime?
  // Thời điểm tạo lời mời.
  createdAt DateTime @default(now())

  // Quan hệ tới lớp học.
  class Class @relation(fields: [classId], references: [id])

  @@schema("course")
  @@map("class_invitations")
}

// Bảng bài học của lớp, hỗ trợ nhiều loại nội dung và AI summary.
model Lesson {
  // Khóa chính bài học.
  id            String   @id @default(uuid())
  // ID lớp học chứa bài học.
  classId       String
  // Tiêu đề bài học.
  title         String
  // Loại nội dung: video, document, text...
  contentType   String
  // URL tài nguyên (video/file) nếu có.
  url           String?
  // Nội dung văn bản bài học (khi là text hoặc trích xuất từ tài liệu).
  bodyText      String?  @db.Text
  // Thứ tự bài học trong lớp.
  orderIndex    Int
  // Nội dung tóm tắt do AI sinh.
  aiSummaryText String?  @db.Text
  // Từ khóa chính do AI trích xuất (JSON array).
  aiKeywords    Json?
  // Thời điểm tạo bài học.
  createdAt     DateTime @default(now())

  // Quan hệ tới lớp học.
  class      Class            @relation(fields: [classId], references: [id])
  // Quan hệ tới bảng tiến độ theo học sinh.
  progresses LessonProgress[]

  @@schema("lesson")
  @@map("lessons")
}

// Bảng theo dõi tiến độ từng học sinh trên từng bài học.
model LessonProgress {
  // Khóa chính bản ghi tiến độ.
  id          String   @id @default(uuid())
  // ID học sinh.
  studentId   String
  // ID bài học.
  lessonId    String
  // Đánh dấu đã hoàn thành bài học hay chưa.
  isCompleted Boolean  @default(false)
  // Thời điểm cập nhật tiến độ gần nhất.
  updatedAt   DateTime @updatedAt

  // Quan hệ tới học sinh.
  student User   @relation(fields: [studentId], references: [id])
  // Quan hệ tới bài học.
  lesson  Lesson @relation(fields: [lessonId], references: [id])

  // Mỗi học sinh chỉ có 1 bản ghi tiến độ cho mỗi bài học.
  @@unique([studentId, lessonId])
  @@schema("lesson")
  @@map("lesson_progress")
}

// Bảng giao dịch thanh toán học phí (ví dụ qua MoMo).
model Transaction {
  // Khóa chính giao dịch.
  id          String   @id @default(uuid())
  // ID học sinh thanh toán.
  studentId   String
  // ID lớp học được thanh toán.
  classId     String
  // Số tiền thanh toán.
  amount      Decimal  @db.Decimal(12, 2)
  // Mã đơn hàng từ cổng MoMo, duy nhất.
  momoOrderId String   @unique
  // Trạng thái giao dịch: pending, success, failed.
  status      String   @default("pending")
  // Thời điểm tạo giao dịch.
  createdAt   DateTime @default(now())

  // Quan hệ tới học sinh.
  student User  @relation(fields: [studentId], references: [id])
  // Quan hệ tới lớp học.
  class   Class @relation(fields: [classId], references: [id])

  @@schema("payment")
  @@map("transactions")
}

// Bảng log sử dụng AI để theo dõi chi phí và hành vi dùng tính năng AI.
model AiUsageLog {
  // Khóa chính log.
  id           String   @id @default(uuid())
  // ID người dùng đã gọi tính năng AI.
  userId       String
  // Loại tính năng AI: quiz_gen, summary, chat_buddy, moderation...
  featureType  String
  // Tên model AI đã dùng (gpt-4o-mini, gemini-flash...).
  modelUsed    String
  // Số token đầu vào.
  inputTokens  Int      @default(0)
  // Số token đầu ra.
  outputTokens Int      @default(0)
  // Thời điểm phát sinh lượt dùng.
  createdAt    DateTime @default(now())

  // Quan hệ tới user.
  user User @relation(fields: [userId], references: [id])

  @@schema("system")
  @@map("ai_usage_logs")
}

// Bảng nội dung bị AI/moderator gắn cờ để kiểm duyệt.
model FlaggedContent {
  // Khóa chính bản ghi gắn cờ.
  id           String   @id @default(uuid())
  // ID nội dung gốc (comment/message/post...) trong hệ thống nguồn.
  contentId    String
  // ID người tạo nội dung bị gắn cờ.
  userId       String
  // Nội dung gốc bị gắn cờ.
  originalText String   @db.Text
  // Lý do do AI trả về khi gắn cờ.
  aiReason     String?
  // Mức độ nghiêm trọng: low, medium, high.
  severity     String   @default("low")
  // Trạng thái xử lý: pending, deleted, ignored.
  status       String   @default("pending")
  // Thời điểm tạo bản ghi gắn cờ.
  createdAt    DateTime @default(now())

  // Quan hệ tới user tạo nội dung.
  user User @relation(fields: [userId], references: [id])

  @@schema("system")
  @@map("flagged_contents")
}